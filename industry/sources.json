    {
      "id": "web-macroblock-news",
      "name": "Macroblock News",
      "owner_entity_id": "macroblock",
      "config": {
        "url": "https://www.mblock.com.tw/en/news",
        "parseMode": "html",
        "itemSelector": "li.alldata .news_box",
        "linkSelector": "a[href*=\"/en/news/detail/\"]",
        "titleSelector": ".txt > p",
        "allowUrlPrefixes": [
          "https://www.mblock.com.tw/en/news/detail/"
        ],
        "acceptLanguage": "en",
        "publishedAtUtcOffset": "+08:00",
        "detail": {
          "maxFetches": 8,
          "titleSelector": ".news_title h5",
          "publishedAtRegex": "\"datePublished\"\\s*:\\s*\"(\\d{4}-\\d{2}-\\d{2})\"",
          "publishedAtAuthoritative": true
        },
        "_aihot": {
          "initialBackfillLimit": 8,
          "initialBackfillMonths": 6
        }
      },
      "kind": "web_list",
      "tier": "T1",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
    {
      "id": "web-kinglight-news",
      "name": "Kinglight News",
      "owner_entity_id": "kinglight",
      "config": {
        "url": "https://en.kinglight.com/category/blog/news",
        "parseMode": "html",
        "itemSelector": "#news-page .top .right, #news-page .bottom > .list",
        "linkSelector": "a[href*=\"/blog/\"]",
        "titleSelector": "h2",
        "publishedAtSelector": ".time",
        "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": [
          "https://en.kinglight.com/blog/"
        ],
        "acceptLanguage": "en",
        "detail": {
          "maxFetches": 8,
          "titleSelector": "h1.news-tit",
          "titleAuthoritative": true,
          "publishedAtSelector": "#newsshow > .top .tnh span",
          "publishedAtAuthoritative": true
        },
        "_aihot": {
          "initialBackfillLimit": 8,
          "initialBackfillMonths": 6
        }
      },
      "kind": "web_list",
      "tier": "T1",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
    {
      "id": "web-nationstar-product-news",
      "name": "Nationstar Product News",
      "owner_entity_id": "nationstar",
      "config": {
        "url": "https://www.nationstar.com/nationstar/channel/product_news",
        "parseMode": "html",
        "itemSelector": "ul.mar_list > li.item",
        "linkSelector": ".info a.title",
        "titleSelector": ".info a.title",
        "publishedAtSelector": ".bot .tag:first-child",
        "publishedAtUtcOffset": "+08:00",
        "allowUrlPrefixes": [
          "https://www.nationstar.com/nationstar/content/"
        ],
        "acceptLanguage": "en",
        "detail": {
          "maxFetches": 8,
          "titleSelector": ".arc_content > h1.title",
          "publishedAtSelector": ".arc_content > .tag > span:nth-child(2)"
        },
        "_aihot": {
          "initialBackfillLimit": 8,
          "initialBackfillMonths": 6
        }
      },
      "kind": "web_list",
      "tier": "T1",
