    {
      "id": "web-macroblock-news",
      "name": "Macroblock News",
      "owner_entity_id": "macroblock",
      "config": {
        "url": "https://www.mblock.com.tw/en/news",
        "parseMode": "html",
        "itemSelector": "li.alldata .news_box",
        "linkSelector": "a[href*=\"/en/news/detail/\"]",
        "titleSelector": ".txt > p",
        "allowUrlPrefixes": [
          "https://www.mblock.com.tw/en/news/detail/"
        ],
        "acceptLanguage": "en",
        "publishedAtUtcOffset": "+08:00",
        "detail": {
          "maxFetches": 8,
          "titleSelector": ".news_title h5",
          "publishedAtRegex": "\"datePublished\"\\s*:\\s*\"(\\d{4}-\\d{2}-\\d{2})\"",
          "publishedAtAuthoritative": true
        },
        "_aihot": {
          "initialBackfillLimit": 8,
          "initialBackfillMonths": 6
        }
      },
      "kind": "web_list",
      "tier": "T1",
      "participation_mode": "editorial",
      "interval_minutes": 360,
      "tags": [],
      "site_fulltext": false,
      "syndicate_fulltext": false,
      "enabled": false
    },
